{
  "manifest_version": 3,
  "name": "GGAB Local Companion",
  "version": "1.5.1",
  "minimum_chrome_version": "116",
  "description": "无界面的本地 Match Tracker 后台迁移、状态同步与逐拍 CSV 导出。",
  "permissions": ["storage", "alarms", "tabs", "scripting"],
  "host_permissions": ["http://127.0.0.1/*", "https://app.getgoodatbadminton.com/*", "https://adscteqgwmvherkctzfm.supabase.co/*"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [
    {"matches": ["http://127.0.0.1/*"], "js": ["local.js"], "run_at": "document_idle"},
    {"matches": ["https://app.getgoodatbadminton.com/*"], "js": ["remote.js"], "run_at": "document_idle"}
  ]
}
